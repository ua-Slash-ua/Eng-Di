{
  "name": "MainApi",
  "version": "1.0.0",
  "private": true,
  "description": "EngDi NestJS REST API",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build && node -e \"require('fs').accessSync('dist/main.js'); console.log('Nest build OK')\"",
    "start": "node dist/main.js --port=3000 --host=127.1.6.104",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "node scripts/prisma-with-env.mjs db push",
    "db:sync-prod": "node scripts/sync-stage-to-prod.mjs --yes"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "imapflow": "^1.7.1",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
