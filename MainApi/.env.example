# api.eng-di.com (MainApi)
# Bind (PORT/HOST) — у package.json → scripts.start

# PROD | STAGE — локальна розробка = STAGE
ENV=STAGE

DATABASE_URL_STAGE="mysql://USER:PASSWORD@HOST:3306/slash00_engdi"
DATABASE_URL_PROD="mysql://USER:PASSWORD@HOST:3306/slash00_engdiprod"

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

COOKIE_SECURE=true

# Pending account activation (hours until unactivated account is deleted)
PENDING_ACCOUNT_TTL_HOURS=24

# Seed accounts on startup
ADMIN_EMAIL=admin@eng-di.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=change-me-admin

STUDENT_EMAIL=student@eng-di.com
STUDENT_NAME=Учень
STUDENT_PASSWORD=change-me-student

TEACHER_EMAIL=teacher@eng-di.com
TEACHER_NAME=Вчитель
TEACHER_PASSWORD=change-me-teacher

USER_PANEL_ORIGIN=https://www.eng-di.com
ADMIN_PANEL_ORIGIN=https://admin.eng-di.com
# Дозволені origins для браузерних запитів (через кому)
CORS_ORIGINS=https://www.eng-di.com,https://eng-di.com,https://admin.eng-di.com,http://localhost:3000,http://localhost:3001

# SMTP (Gmail)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_email@gmail.com
# IMAP (bounce / «адресу не знайдено»). Якщо порожньо — беруться SMTP_USERNAME/PASSWORD.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_ENABLED=true
RESET_PASSWORD_URL_BASE=https://www.eng-di.com
